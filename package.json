{
  "name": "timber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --config apps/api/wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:computer": "python3 -m unittest discover -s infra/computer/tests -v",
    "check": "npm run typecheck && npm test && npm run test:runtime && npm run test:computer",
    "deploy": "wrangler deploy --config apps/api/wrangler.jsonc",
    "smoke": "node scripts/smoke.mjs",
    "deploy:bootstrap": "wrangler deploy --config apps/api/wrangler.bootstrap.jsonc",
    "test:runtime": "vitest run --config packages/runtime/vitest.config.ts",
    "access:setup": "node scripts/set-access-token.mjs",
    "access:copy": "node scripts/copy-access-token.mjs"
  },
  "dependencies": {
    "agents": "0.26.0",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-durable": "1.0.3",
    "@cloudflare/sandbox": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261005.1",
    "@types/node": "^24.0.0",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "4.147.0"
  }
}
